<clickhouse>
  <listen_host>127.0.0.1</listen_host>
  <!-- Tributary uses only the native (9000) and HTTP (8123) ports; turn off
       ClickHouse's MySQL and PostgreSQL protocols and its replication port. -->
  <mysql_port remove="1"/>
  <postgresql_port remove="1"/>
  <interserver_http_port remove="1"/>
  <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
  <memory_worker_dynamic_hard_limit>0</memory_worker_dynamic_hard_limit>
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <!-- Query threads across all queries: one per core, leaving headroom for
       nfad and ClickHouse's own background work. -->
  <concurrent_threads_soft_limit_ratio_to_cores>1</concurrent_threads_soft_limit_ratio_to_cores>
  <background_schedule_pool_size>8</background_schedule_pool_size>
  <logger><level>warning</level><size>100M</size><count>3</count></logger>
  <query_log replace="1"><database>system</database><table>query_log</table><ttl>event_date + INTERVAL 3 DAY</ttl></query_log>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <processors_profile_log remove="1"/>
  <latency_log remove="1"/>
</clickhouse>
