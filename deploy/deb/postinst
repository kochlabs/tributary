#!/bin/sh
# Tributary post-installation: service account, directories, ClickHouse
# credentials, migration from the old install.sh layout, and unit start-up.
set -e

[ "$1" = configure ] || exit 0

CH_RESTART=no

# Service account and state directories.
if ! getent passwd nfa >/dev/null; then
  adduser --system --group --home /var/lib/nfa --no-create-home --shell /usr/sbin/nologin nfa >/dev/null
fi
install -d -o nfa -g nfa -m 750 /var/lib/nfa /var/lib/nfa/admin-request
install -d -o root -g nfa -m 750 /var/lib/tributary-admin

# ClickHouse user for Tributary, with a generated password kept in /etc/netflow.
install -d -m 755 /etc/netflow
if [ ! -s /etc/netflow/clickhouse.pw ]; then
  (umask 077; openssl rand -hex 16 > /etc/netflow/clickhouse.pw)
fi
chgrp nfa /etc/netflow/clickhouse.pw
chmod 640 /etc/netflow/clickhouse.pw
HASH=$(tr -d '\n' < /etc/netflow/clickhouse.pw | sha256sum | cut -d' ' -f1)
USERS=/etc/clickhouse-server/users.d/netflow.xml
# write_ch_users FILE CONTENT: installs a users.d file if it changed.
write_ch_users() {
  if [ ! -f "$1" ] || [ "$(cat "$1")" != "$2" ]; then
    install -d -m 755 /etc/clickhouse-server/users.d
    printf '%s\n' "$2" > "$1"
    chmod 640 "$1"; chgrp clickhouse "$1" 2>/dev/null || true
    CH_RESTART=yes
  fi
}
write_ch_users "$USERS" "$(/usr/lib/tributary/clickhouse-users.sh netflow "$HASH")"

# ClickHouse's built-in "default" user is an administrator with no password
# unless one was chosen when ClickHouse was installed (users.d/
# default-password.xml). Give it a random password, kept for root in
# /etc/tributary/clickhouse-default.pw, so local accounts can't use the
# database as an administrator. To choose your own, write it to that file and
# run dpkg-reconfigure tributary.
DEFAULT_USERS=/etc/clickhouse-server/users.d/tributary-default.xml
DEFAULT_PW=/etc/tributary/clickhouse-default.pw
if [ -f /etc/clickhouse-server/users.d/default-password.xml ]; then
  if [ -f "$DEFAULT_USERS" ]; then rm -f "$DEFAULT_USERS"; CH_RESTART=yes; fi
else
  install -d -m 755 /etc/tributary
  if [ ! -s "$DEFAULT_PW" ]; then
    (umask 077; openssl rand -hex 16 > "$DEFAULT_PW")
  fi
  chown root:root "$DEFAULT_PW"; chmod 600 "$DEFAULT_PW"
  DHASH=$(tr -d '\n' < "$DEFAULT_PW" | sha256sum | cut -d' ' -f1)
  write_ch_users "$DEFAULT_USERS" "$(/usr/lib/tributary/clickhouse-users.sh default "$DHASH")"
fi

# Migrate from the pre-package layout (deploy/install.sh into /usr/local).
legacy=no
for f in /etc/systemd/system/nfad.service /etc/systemd/system/tributary-admin.path \
         /etc/systemd/system/tributary-admin.service /etc/systemd/system/tributary-update-check.service \
         /etc/systemd/system/tributary-update-check.timer /etc/systemd/system/tributary-update.path \
         /etc/systemd/system/tributary-update.service; do
  if [ -f "$f" ]; then rm -f "$f"; legacy=yes; fi
done
# Remove only links to the old unit files: links to the packaged units are
# how the units are enabled and must stay.
for f in /etc/systemd/system/multi-user.target.wants/nfad.service \
         /etc/systemd/system/multi-user.target.wants/tributary-admin.path \
         /etc/systemd/system/timers.target.wants/tributary-update-check.timer; do
  if [ -L "$f" ]; then
    case "$(readlink "$f")" in /etc/systemd/system/*) rm -f "$f" ;; esac
  fi
done
rm -f /usr/local/bin/nfad /usr/local/bin/nfa-flowgen
rm -rf /usr/local/lib/tributary
rm -f /etc/sysctl.d/99-nfa.conf
if [ -f /etc/clickhouse-server/config.d/netflow-appliance.xml ]; then
  rm -f /etc/clickhouse-server/config.d/netflow-appliance.xml
  CH_RESTART=yes
fi
[ "$legacy" = yes ] && echo "tributary: migrated the previous install.sh layout to the packaged layout"

# Restart ClickHouse only when its configuration changed (or on first install).
STAMP=/var/lib/tributary-admin/.clickhouse-config
SUM=$(cat /etc/clickhouse-server/config.d/tributary.xml "$USERS" "$DEFAULT_USERS" 2>/dev/null | sha256sum | cut -d' ' -f1)
[ "$(cat "$STAMP" 2>/dev/null)" = "$SUM" ] || CH_RESTART=yes

sysctl -q --load /usr/lib/sysctl.d/99-tributary.conf || true

UNITS="nfad.service tributary-admin.path tributary-update-check.timer"
# Earlier packages deleted their own enable links on every upgrade, which
# deb-systemd-helper then took for an administrator's choice to disable the
# units, so they no longer started at boot. Forget that state once so the
# units are enabled again.
REPAIRED=/var/lib/tributary-admin/.units-reenabled
if [ ! -e "$REPAIRED" ]; then
  for u in $UNITS; do deb-systemd-helper purge "$u" >/dev/null 2>&1 || true; done
  touch "$REPAIRED"
fi
for u in $UNITS; do
  deb-systemd-helper unmask "$u" >/dev/null || true
  deb-systemd-helper enable "$u" >/dev/null || true
done
# Only touch running services on a live systemd host (not in chroots/images).
if [ -d /run/systemd/system ]; then
  systemctl --system daemon-reload >/dev/null || true
  if [ "$CH_RESTART" = yes ]; then
    deb-systemd-invoke restart clickhouse-server.service
    echo "$SUM" > "$STAMP"
  fi
  deb-systemd-invoke restart nfad.service
  deb-systemd-invoke start tributary-admin.path tributary-update-check.timer
fi

[ -d /run/systemd/system ] || exit 0
for _ in $(seq 30); do
  curl -sfk https://localhost/healthz >/dev/null 2>&1 && break
  sleep 1
done
echo "Tributary is running: https://$(hostname -I 2>/dev/null | awk '{print $1}')/"
if [ -f /var/lib/nfa/initial-admin-password ]; then
  echo "Initial login: admin / $(cat /var/lib/nfa/initial-admin-password)"
  echo "(change it after signing in, then delete /var/lib/nfa/initial-admin-password)"
fi
exit 0
